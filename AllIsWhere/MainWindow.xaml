<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AllIsWhere.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AllIsWhere" Height="800" Width="1180" MinHeight="580" MinWidth="760" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" WindowStartupLocation="CenterScreen" xmlns:alliswhere="clr-namespace:AllIsWhere;assembly=AllIsWhere" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource PrimaryContainerBrush}" VerticalAlignment="Center" Margin="0,0,14,0">
          <TextBlock Text="⌕" FontSize="35" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-7,0,0" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Name="HeaderTitle" Text="AllIsWhere" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
            <Border Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="8" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Name="VersionText" Text="v1.2.3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
            </Border>
          </StackPanel>
          <TextBlock Name="TaglineText" Text="Yerel disk, klasör ve ağ paylaşımında anlık arama" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Name="UpdateCheckButton" Content="Güncellemeleri denetle" MinWidth="178" Margin="0,0,8,0" Click="CheckForUpdates_Click" />
        <Button Name="SettingsButton" Content="Ayarlar" MinWidth="98" Click="Settings_Click" />
      </WrapPanel>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
          <TextBlock Name="SourcesLabel" Text="Kaynaklar" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0" DockPanel.Dock="Left" />
          <WrapPanel HorizontalAlignment="Right" DockPanel.Dock="Right">
            <Button Name="RemoveSourceButton" Content="Seçileni kaldır" MinWidth="130" Margin="0,0,8,0" IsEnabled="False" Click="RemoveSource_Click" />
            <Button Name="RefreshSourceButton" Content="Kaynağı yenile" MinWidth="128" Margin="0,0,8,0" IsEnabled="False" Click="RefreshSources_Click" />
            <Button Name="AddFolderButton" Content="Klasör veya ağ ekle…" MinWidth="166" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Click="AddFolder_Click" />
            <ComboBox Name="DriveSelector" Width="290" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" SelectionChanged="DriveSelector_SelectionChanged" />
          </WrapPanel>
        </DockPanel>
        <ListBox Name="SourcesList" Grid.Row="2" Height="68" Background="#00FFFFFF" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="SourcesList_SelectionChanged">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource PrimaryContainerBrush}" CornerRadius="12" Padding="12,8" Margin="0,0,8,0" MaxWidth="360">
                <TextBlock MaxWidth="336" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" Text="{Binding Label}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <Border Grid.Row="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,4">
      <Grid Height="56">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="⌕" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Height="30" VerticalAlignment="Center" />
        <TextBox Name="SearchBox" Grid.Column="2" Height="54" FontSize="19" Padding="14,0" Background="#00FFFFFF" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="Dosya veya klasör adı yazın" TextChanged="SearchBox_TextChanged" />
      </Grid>
    </Border>
    <Border Grid.Row="6" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14,10">
      <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Name="FilterLabel" Text="Tür:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="2,0,10,0" />
        <ComboBox Name="TypeFilterBox" Width="150" Margin="0,0,8,0" SelectionChanged="Filter_Changed">
          <ComboBoxItem Name="AllTypesItem" Content="Tüm türler" Tag="All" IsSelected="True" />
          <ComboBoxItem Name="FilesItem" Content="Dosyalar" Tag="Files" />
          <ComboBoxItem Name="FoldersItem" Content="Klasörler" Tag="Folders" />
        </ComboBox>
        <Grid Margin="0,0,8,0">
          <ToggleButton Name="ExtensionFilterToggle" Content="Uzantı: Tümü" Width="154" Height="38" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrush}" Click="ExtensionFilterToggle_Click" />
          <Popup Name="ExtensionFilterPopup" Placement="Bottom" StaysOpen="False" PlacementTarget="{Binding ElementName=ExtensionFilterToggle}" IsOpen="{Binding IsChecked, ElementName=ExtensionFilterToggle, Mode=TwoWay}">
            <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Width="300">
              <StackPanel>
                <TextBlock Name="ExtensionPopupTitle" Text="Uzantı filtresi" FontWeight="SemiBold" Margin="0,0,0,10" />
                <UniformGrid Name="ExtensionOptionsPanel" Columns="2">
                  <CheckBox Content=".pdf" Tag=".pdf" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".docx" Tag=".docx" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".xlsx" Tag=".xlsx" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".pptx" Tag=".pptx" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".txt" Tag=".txt" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".csv" Tag=".csv" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".jpg" Tag=".jpg" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".png" Tag=".png" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".mp4" Tag=".mp4" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                  <CheckBox Content=".zip" Tag=".zip" Checked="Extension_Changed" Unchecked="Extension_Changed" />
                </UniformGrid>
                <TextBox Name="ExtensionFilterBox" Height="38" Margin="0,12,0,0" Padding="10,7" VerticalContentAlignment="Center" ToolTip="Özel uzantılar (pdf; docx)" TextChanged="ExtensionFilterBox_TextChanged" />
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
        <CheckBox Name="HiddenFoldersCheckBox" Content="Gizli klasörleri göster" VerticalAlignment="Center" Margin="4,0,12,0" MaxWidth="230" />
        <ComboBox Name="ModifiedFilterBox" Width="150" Margin="0,0,8,0" ToolTip="Değiştirilme tarihi" SelectionChanged="Filter_Changed">
          <ComboBoxItem Content="Her zaman" Tag="0" IsSelected="True" />
          <ComboBoxItem Content="Son 24 saat" Tag="1" />
          <ComboBoxItem Content="Son 7 gün" Tag="7" />
          <ComboBoxItem Content="Son 30 gün" Tag="30" />
          <ComboBoxItem Content="Son 365 gün" Tag="365" />
        </ComboBox>
        <ComboBox Name="SizeFilterBox" Width="150" Margin="0,0,8,0" ToolTip="Dosya boyutu" SelectionChanged="Filter_Changed">
          <ComboBoxItem Content="Her boyut" Tag="All" IsSelected="True" />
          <ComboBoxItem Content="1 MB üzeri" Tag="1" />
          <ComboBoxItem Content="10 MB üzeri" Tag="10" />
          <ComboBoxItem Content="100 MB üzeri" Tag="100" />
          <ComboBoxItem Content="1 GB üzeri" Tag="1024" />
        </ComboBox>
        <ComboBox Name="SavedSearchBox" Width="185" Margin="0,0,8,0" ToolTip="Kayıtlı aramalar" SelectionChanged="SavedSearchBox_SelectionChanged" />
        <Button Name="SaveSearchButton" Content="Aramayı kaydet" Margin="0,0,8,0" Click="SaveSearch_Click" />
        <Button Name="RemoveSavedSearchButton" Content="Kayıtlı aramayı sil" Margin="0,0,8,0" IsEnabled="False" Click="RemoveSavedSearch_Click" />
        <ComboBox Name="SourceFilterBox" Width="250" SelectionChanged="Filter_Changed" />
      </WrapPanel>
    </Border>
    <Border Grid.Row="8" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="12,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="ResultsHeading" Text="Arama sonuçları" FontWeight="SemiBold" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" />
          <ComboBox Name="SortBox" Grid.Column="1" Width="170" Height="34" SelectionChanged="Filter_Changed">
            <ComboBoxItem Name="SortNameItem" Content="Ad · A–Z" Tag="Name" IsSelected="True" />
            <ComboBoxItem Name="SortPathItem" Content="Yol" Tag="Path" />
            <ComboBoxItem Name="SortTypeItem" Content="Tür" Tag="Type" />
          </ComboBox>
        </Grid>
        <Grid Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="10,2,12,4" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="2.2*" />
              <ColumnDefinition Width="4.5*" />
              <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="NameColumnHeader" Grid.Column="1" Text="Ad" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Name="PathColumnHeader" Grid.Column="2" Text="Konum" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Name="TypeColumnHeader" Grid.Column="3" Text="Tür" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
          </Grid>
          <ListView Name="ResultsList" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" Foreground="{DynamicResource TextPrimary}" ScrollViewer.IsDeferredScrollingEnabled="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionMode="Extended" ScrollViewer.CanContentScroll="True" MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,3">
                  <FrameworkElement.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="ResultContextMenu_Opened">
                      <MenuItem Tag="CopyItem" Header="Kopyala" InputGestureText="Ctrl+C" Click="CopyResultItem_Click" />
                      <MenuItem Tag="CopyPath" Header="Yolu kopyala" Click="CopyResultPath_Click" />
                      <MenuItem Tag="OpenLocation" Header="Dosya konumunu aç" Click="RevealResult_Click" />
                      <Separator />
                      <MenuItem Tag="Open" Header="Aç" Click="OpenResult_Click" />
                    </ContextMenu>
                  </FrameworkElement.ContextMenu>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="4.5*" />
                    <ColumnDefinition Width="0.9*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="12" Background="{DynamicResource PrimaryContainerBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Path Data="M3,2 L10,2 L13,5 L13,14 L3,14 M10,2 L10,5 L13,5 M5,8 L11,8 M5,10 L11,10 M5,12 L9,12" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type Path}">
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsDirectory}">
                              <Setter Property="Data" Value="M1,4 L6,4 L8,6 L15,6 L15,14 L1,14 M1,4 L1,3 L6,3 L8,5 L14,5" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </Path>
                  </Border>
                  <TextBlock Grid.Column="1" FontSize="{DynamicResource ResultFontSize}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,8,0" Text="{Binding Name}" />
                  <TextBlock Grid.Column="2" FontSize="{DynamicResource DetailFontSize}" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,8,0" Text="{Binding Path}" ToolTip="{Binding Path}" />
                  <TextBlock Grid.Column="3" FontSize="{DynamicResource DetailFontSize}" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding TypeLabel}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListView>
          <Border Name="EmptyStatePanel" Grid.Row="1" Background="{DynamicResource PanelBackground}" IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="24">
              <ProgressBar Name="SearchProgressBar" Width="160" Height="5" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBackground}" Margin="0,0,0,18" Visibility="Collapsed" />
              <TextBlock Name="EmptyStateTitle" Text="Aramaya başlayın" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Name="EmptyStateDescription" Text="Dosya veya klasör adı yazın." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Grid Row="10" Margin="4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Name="StatusText" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Name="FolderProgressPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" Visibility="Collapsed">
        <TextBlock Name="FolderProgressText" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="360" TextTrimming="CharacterEllipsis" />
        <ProgressBar Width="140" Height="6" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBackground}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Name="CountText" Grid.Column="2" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</Window>
