<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AllIsWhere.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ayarlar" Width="600" Height="710" MinWidth="520" MinHeight="560" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" xmlns:alliswhere="clr-namespace:AllIsWhere;assembly=AllIsWhere">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Name="SettingsTitle" Text="Görünüm ve arama" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Name="SettingsDescription" Text="Değişiklikler bu bilgisayardaki kullanıcı hesabınıza kaydedilir." Margin="0,5,0,0" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="0,0,8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="16" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Name="AppearanceSectionLabel" Grid.Row="0" Text="Görünüm" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Name="ThemeLabel" Text="Tema" FontWeight="SemiBold" />
              <TextBlock Name="ThemeDescription" Text="Açık tema daha yüksek okunabilirlik sunar." Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Name="ThemeBox" Grid.Column="1">
              <ComboBoxItem Name="LightThemeItem" Content="Açık" Tag="Light" />
              <ComboBoxItem Name="DarkThemeItem" Content="Koyu" Tag="Dark" />
            </ComboBox>
          </Grid>
        </Border>
        <Border Grid.Row="4" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="FontSizeLabel" Text="Sonuç yazı boyutu" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox Name="FontSizeBox" Grid.Column="1">
              <ComboBoxItem Name="SmallFontItem" Content="Küçük · 12" Tag="12" />
              <ComboBoxItem Name="NormalFontItem" Content="Normal · 14" Tag="14" />
              <ComboBoxItem Name="LargeFontItem" Content="Büyük · 16" Tag="16" />
              <ComboBoxItem Name="ExtraLargeFontItem" Content="Çok büyük · 18" Tag="18" />
            </ComboBox>
          </Grid>
        </Border>
        <TextBlock Name="SearchSectionLabel" Grid.Row="6" Text="Arama ve tarama" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <Border Grid.Row="8" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Name="MaxResultsLabel" Text="En fazla sonuç" FontWeight="SemiBold" />
              <TextBlock Name="MaxResultsDescription" Text="Arayüzde gösterilecek üst sınır." Foreground="{DynamicResource TextMuted}" FontSize="12" />
            </StackPanel>
            <ComboBox Name="MaxResultsBox" Grid.Column="1">
              <ComboBoxItem Content="250" Tag="250" />
              <ComboBoxItem Content="500" Tag="500" />
              <ComboBoxItem Content="1.000" Tag="1000" />
              <ComboBoxItem Content="2.500" Tag="2500" />
              <ComboBoxItem Content="5.000" Tag="5000" />
            </ComboBox>
          </Grid>
        </Border>
        <Border Grid.Row="10" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Name="SearchDelayLabel" Text="Arama gecikmesi" FontWeight="SemiBold" />
              <TextBlock Name="SearchDelayDescription" Text="Yazarken aramadan önce beklenecek süre." Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Name="DebounceBox" Grid.Column="1">
              <ComboBoxItem Name="InstantDelayItem" Content="Anında" Tag="0" />
              <ComboBoxItem Content="50 ms" Tag="50" />
              <ComboBoxItem Content="100 ms" Tag="100" />
              <ComboBoxItem Content="200 ms" Tag="200" />
            </ComboBox>
          </Grid>
        </Border>
        <Border Grid.Row="12" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Name="ScanPerformanceLabel" Text="Tarama performansı" FontWeight="SemiBold" />
              <TextBlock Name="ScanPerformanceDescription" Text="Düşük kaynak kullanımı için tarama yavaşlayabilir." Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Name="ScanPerformanceBox" Grid.Column="1">
              <ComboBoxItem Name="FastScanItem" Content="Hızlı" Tag="Fast" />
              <ComboBoxItem Name="BalancedScanItem" Content="Dengeli" Tag="Balanced" />
              <ComboBoxItem Name="LowResourceItem" Content="Düşük kaynak" Tag="LowResource" />
            </ComboBox>
          </Grid>
        </Border>
        <TextBlock Name="StartupSectionLabel" Grid.Row="14" Text="Başlangıç ve dil" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <Border Grid.Row="16" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <CheckBox Name="StartWithWindowsBox" Content="Windows oturum açılışında çalıştır" VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="18" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="LanguageLabel" Text="Dil" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox Name="LanguageBox" Grid.Column="1">
              <ComboBoxItem Content="Türkçe" Tag="tr" />
              <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
          </Grid>
        </Border>
        <TextBlock Name="ExclusionsSectionLabel" Grid.Row="20" Text="Hariç tutulan klasörler" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <Border Grid.Row="22" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
          <StackPanel>
            <TextBlock Name="ExcludedFoldersDescription" Text="Her satıra bir klasör yolu yazın. Bu yolların içeriği arama sonuçlarında gösterilmez." Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBox Name="ExcludedFoldersBox" MinHeight="90" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" />
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Name="CancelButton" Content="Vazgeç" Width="104" Margin="0,0,10,0" IsCancel="True" />
      <Button Name="SaveButton" Content="Kaydet" Width="112" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
