<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AllIsWhere</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <Nullable>enable</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="AllIsWhere\App.xaml" />
    <ApplicationDefinition Include="AllIsWhere\App.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="app.xaml" />
    <Page Remove="AllIsWhere\AddSourceWindow.xaml" />
    <Page Remove="AllIsWhere\MainWindow.xaml" />
    <Page Remove="AllIsWhere\SettingsWindow.xaml" />
    <Page Include="AllIsWhere\AddSourceWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="addsourcewindow.xaml" />
    <Page Include="AllIsWhere\MainWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="mainwindow.xaml" />
    <Page Include="AllIsWhere\SettingsWindow.xaml" Generator="MSBuild:Compile" SubType="Designer" LogicalName="settingswindow.xaml" />
  </ItemGroup>
  <ItemGroup><Compile Remove="installer\**\*.cs" /></ItemGroup>
</Project>
