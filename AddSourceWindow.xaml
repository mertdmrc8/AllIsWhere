<Window x:Class="AllIsWhere.AddSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaynak ekle" Width="620" Height="255" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="DialogTitle" Text="Klasör veya ağ kaynağı ekle" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="DialogDescription" Text="Yerel yol, bağlı sürücü (ör. Z:\Klasör) veya UNC ağ yolu kullanabilirsiniz."
                 Margin="0,5,0,0" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
    </StackPanel>
    <DockPanel Grid.Row="2">
      <Button x:Name="BrowseButton" Content="Gözat…" DockPanel.Dock="Right" Width="92" Height="34" Margin="8,0,0,0"
              Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBackground}"
              BorderBrush="{DynamicResource BorderBrush}" Click="Browse_Click"/>
      <TextBox x:Name="PathBox" Height="34" Padding="9,6" VerticalContentAlignment="Center"
               Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}"
               BorderBrush="{DynamicResource BorderBrush}" ToolTip="Örnek: \\sunucu\paylaşım\klasör"/>
    </DockPanel>
    <TextBlock x:Name="PathExample" Grid.Row="4" Text="Örnek: \\sunucu\paylaşım\klasör veya Z:\Belgeler"
               Foreground="{DynamicResource TextMuted}" FontSize="12"/>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="İptal" Width="92" Height="36" Margin="0,0,8,0" IsCancel="True"
              Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBackground}"
              BorderBrush="{DynamicResource BorderBrush}"/>
      <Button x:Name="AddButton" Content="Kaynağı ekle" Width="120" Height="36" IsDefault="True" Click="Add_Click"
              Foreground="White" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
    </StackPanel>
  </Grid>
</Window>
