<Application x:Class="AllIsWhere.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- The default theme is light, high-contrast, and easy to read. -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F5F8" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBackground" Color="#E8EDF4" />
    <SolidColorBrush x:Key="TextPrimary" Color="#17202B" />
    <SolidColorBrush x:Key="TextMuted" Color="#536171" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C7D0DC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1769D2" />
    <sys:Double x:Key="ResultFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="DetailFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
  </Application.Resources>
</Application>

