<Window x:Class="AllIsWhere.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AllIsWhere" Height="760" Width="1080" MinHeight="520" MinWidth="700"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
      <RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
        <TextBlock x:Name="HeaderTitle" Text="AllIsWhere" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock x:Name="TaglineText" Text="Yerel disk, klasör ve ağ paylaşımında anlık arama"
                   Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Orientation="Horizontal">
        <ComboBox x:Name="DriveSelector" Width="300" Height="36" VerticalAlignment="Center"
                  Margin="0,0,8,6" Foreground="{DynamicResource TextPrimary}"
                  Background="{DynamicResource InputBackground}"
                  ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
                  SelectionChanged="DriveSelector_SelectionChanged"/>
        <Button x:Name="AddFolderButton" Content="Klasör veya ağ ekle…" Height="36" MinWidth="150" Padding="12,0" Margin="0,0,8,6"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource BorderBrush}" Click="AddFolder_Click"/>
        <Button x:Name="SettingsButton" Content="Ayarlar" Height="36" MinWidth="92" Padding="12,0" Margin="0,0,0,6"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource BorderBrush}" Click="Settings_Click"/>
      </WrapPanel>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,12,0">
        <TextBlock x:Name="SourcesLabel" Text="Kaynaklar" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button x:Name="RemoveSourceButton" Content="Seçileni kaldır" MinWidth="132" Padding="10,5"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource BorderBrush}" Click="RemoveSource_Click" IsEnabled="False"/>
      </StackPanel>
      <ListBox x:Name="SourcesList" Grid.Column="1" MaxHeight="132" Margin="0,0,0,0" Background="Transparent"
               Foreground="{DynamicResource TextPrimary}"
               BorderThickness="0" SelectionChanged="SourcesList_SelectionChanged"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate><Border Background="{DynamicResource ControlBackground}" CornerRadius="5" Padding="10,7" Margin="0,0,7,7" MaxWidth="340">
            <TextBlock Text="{Binding Label}" MaxWidth="320" TextWrapping="Wrap"/>
          </Border></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <TextBox x:Name="SearchBox" Grid.Row="4" Height="48" Padding="14,10" FontSize="18"
             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}"
             BorderBrush="{DynamicResource BorderBrush}"
             VerticalContentAlignment="Center" ToolTip="Dosya veya klasör adı yazın"
             TextChanged="SearchBox_TextChanged"/>
    <WrapPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock x:Name="FilterLabel" Text="Tür:" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <ComboBox x:Name="TypeFilterBox" Width="142" Height="34" Margin="0,0,8,6"
                VerticalContentAlignment="Center" Foreground="{DynamicResource TextPrimary}"
                Background="{DynamicResource InputBackground}" SelectionChanged="Filter_Changed">
        <ComboBoxItem x:Name="AllTypesItem" Content="Tüm türler" Tag="All" IsSelected="True"/>
        <ComboBoxItem x:Name="FilesItem" Content="Dosyalar" Tag="Files"/>
        <ComboBoxItem x:Name="FoldersItem" Content="Klasörler" Tag="Folders"/>
      </ComboBox>
      <Grid Margin="0,0,8,6">
        <ToggleButton x:Name="ExtensionFilterToggle" Content="Uzantı: Tümü" Width="154" Height="34"
                      Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}"
                      BorderBrush="{DynamicResource BorderBrush}" Click="ExtensionFilterToggle_Click"/>
        <Popup x:Name="ExtensionFilterPopup" PlacementTarget="{Binding ElementName=ExtensionFilterToggle}"
               Placement="Bottom" StaysOpen="False"
               IsOpen="{Binding IsChecked, ElementName=ExtensionFilterToggle, Mode=TwoWay}">
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="12" Width="290">
            <StackPanel>
              <TextBlock x:Name="ExtensionPopupTitle" Text="Uzantı filtresi" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <UniformGrid x:Name="ExtensionOptionsPanel" Columns="2">
                <CheckBox Content=".pdf" Tag=".pdf" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".docx" Tag=".docx" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".xlsx" Tag=".xlsx" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".pptx" Tag=".pptx" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".txt" Tag=".txt" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".csv" Tag=".csv" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".jpg" Tag=".jpg" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".png" Tag=".png" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".mp4" Tag=".mp4" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
                <CheckBox Content=".zip" Tag=".zip" Checked="Extension_Changed" Unchecked="Extension_Changed"/>
              </UniformGrid>
              <TextBox x:Name="ExtensionFilterBox" Height="32" Margin="0,9,0,0" Padding="8,5"
                       VerticalContentAlignment="Center" Foreground="{DynamicResource TextPrimary}"
                       Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource BorderBrush}"
                       TextChanged="ExtensionFilterBox_TextChanged"/>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
      <CheckBox x:Name="HiddenFoldersCheckBox" Content="Gizli klasörleri göster" VerticalAlignment="Center"
                Margin="2,0,10,6" MaxWidth="230" Foreground="{DynamicResource TextPrimary}"/>
      <ComboBox x:Name="SourceFilterBox" Width="260" Height="34" Margin="0,0,0,6" VerticalContentAlignment="Center"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}"
                SelectionChanged="Filter_Changed"/>
    </WrapPanel>
    <Border Grid.Row="8" Background="{DynamicResource PanelBackground}" CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
      <ListView x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimary}"
                ScrollViewer.IsDeferredScrollingEnabled="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.CanContentScroll="True" MouseDoubleClick="ResultsList_MouseDoubleClick">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Margin="4,5">
              <Grid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="ResultContextMenu_Opened">
                  <MenuItem Tag="CopyPath" Header="Yolu kopyala" Click="CopyResultPath_Click"/>
                  <MenuItem Tag="OpenLocation" Header="Dosya konumunu aç" Click="RevealResult_Click"/>
                  <Separator/>
                  <MenuItem Tag="Open" Header="Aç" Click="OpenResult_Click"/>
                </ContextMenu>
              </Grid.ContextMenu>
              <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Icon}" FontSize="17" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource ResultFontSize}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Path}" FontSize="{DynamicResource DetailFontSize}"
                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>
    <Grid Grid.Row="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"/>
      <StackPanel x:Name="FolderProgressPanel" Grid.Column="1" Orientation="Horizontal"
                  VerticalAlignment="Center" Margin="12,0" Visibility="Collapsed">
        <TextBlock x:Name="FolderProgressText" Foreground="{DynamicResource TextMuted}"
                   VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="360"
                   TextTrimming="CharacterEllipsis"/>
        <ProgressBar Width="150" Height="8" IsIndeterminate="True"
                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBackground}"
                     VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock x:Name="CountText" Grid.Column="2" Foreground="{DynamicResource TextMuted}"
                 VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
  </Grid>
</Window>
