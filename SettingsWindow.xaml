<Window x:Class="AllIsWhere.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Width="480" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="20"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="SettingsTitle" Text="Görünüm ve arama" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="SettingsDescription" Text="Değişiklikler bu bilgisayardaki kullanıcı hesabınıza kaydedilir."
                 Margin="0,5,0,0" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ThemeLabel" Text="Tema" FontWeight="SemiBold"/>
        <TextBlock x:Name="ThemeDescription" Text="Açık tema daha yüksek okunabilirlik sunar." Foreground="{DynamicResource TextMuted}" FontSize="12"/></StackPanel>
      <ComboBox x:Name="ThemeBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}">
        <ComboBoxItem x:Name="LightThemeItem" Content="Açık" Tag="Light"/><ComboBoxItem x:Name="DarkThemeItem" Content="Koyu" Tag="Dark"/>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="FontSizeLabel" Text="Sonuç yazı boyutu" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <ComboBox x:Name="FontSizeBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}">
        <ComboBoxItem x:Name="SmallFontItem" Content="Küçük · 12" Tag="12"/><ComboBoxItem x:Name="NormalFontItem" Content="Normal · 14" Tag="14"/>
        <ComboBoxItem x:Name="LargeFontItem" Content="Büyük · 16" Tag="16"/><ComboBoxItem x:Name="ExtraLargeFontItem" Content="Çok büyük · 18" Tag="18"/>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="MaxResultsLabel" Text="En fazla sonuç" FontWeight="SemiBold"/>
        <TextBlock x:Name="MaxResultsDescription" Text="Arayüzde gösterilecek üst sınır." Foreground="{DynamicResource TextMuted}" FontSize="12"/></StackPanel>
      <ComboBox x:Name="MaxResultsBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}">
        <ComboBoxItem Content="250" Tag="250"/><ComboBoxItem Content="500" Tag="500"/>
        <ComboBoxItem Content="1.000" Tag="1000"/><ComboBoxItem Content="2.500" Tag="2500"/>
        <ComboBoxItem Content="5.000" Tag="5000"/>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SearchDelayLabel" Text="Arama gecikmesi" FontWeight="SemiBold"/>
        <TextBlock x:Name="SearchDelayDescription" Text="Yazarken aramadan önce beklenecek süre." Foreground="{DynamicResource TextMuted}" FontSize="12"/></StackPanel>
      <ComboBox x:Name="DebounceBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}">
        <ComboBoxItem x:Name="InstantDelayItem" Content="Anında" Tag="0"/><ComboBoxItem Content="50 ms" Tag="50"/>
        <ComboBoxItem Content="100 ms" Tag="100"/><ComboBoxItem Content="200 ms" Tag="200"/>
      </ComboBox>
    </Grid>

    <Grid Grid.Row="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="ScanPerformanceLabel" Text="Tarama performansı" FontWeight="SemiBold"/>
        <TextBlock x:Name="ScanPerformanceDescription" Text="Düşük kaynak kullanımı için tarama yavaşlayabilir." Foreground="{DynamicResource TextMuted}" FontSize="12"/></StackPanel>
      <ComboBox x:Name="ScanPerformanceBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}">
        <ComboBoxItem x:Name="FastScanItem" Content="Hızlı" Tag="Fast"/><ComboBoxItem x:Name="BalancedScanItem" Content="Dengeli" Tag="Balanced"/>
        <ComboBoxItem x:Name="LowResourceItem" Content="Düşük kaynak" Tag="LowResource"/>
      </ComboBox>
    </Grid>

    <CheckBox x:Name="StartWithWindowsBox" Grid.Row="12" Content="Windows oturum açılışında çalıştır"
              Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

    <Grid Grid.Row="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="LanguageLabel" Text="Dil" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <ComboBox x:Name="LanguageBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center"
                Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource InputBackground}">
        <ComboBoxItem Content="Türkçe" Tag="tr"/><ComboBoxItem Content="English" Tag="en"/>
      </ComboBox>
    </Grid>

    <StackPanel Grid.Row="16" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Vazgeç" Width="92" Height="36" Margin="0,0,8,0" IsCancel="True"
              Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource ControlBackground}"
              BorderBrush="{DynamicResource BorderBrush}"/>
      <Button x:Name="SaveButton" Content="Kaydet" Width="92" Height="36" IsDefault="True" Click="Save_Click"
              Foreground="White" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
    </StackPanel>
  </Grid>
</Window>
